import pandas as pd
import re
import os
import requests
from bs4 import BeautifulSoup
import numpy as np
import networkx as nx
import matplotlib.pyplot as plt
from networkx.drawing.nx_agraph import graphviz_layout

def plot_course_dependency_graph(subject_code, completed_courses, save_path="course_graph.png"):
    completed_courses = [re.sub(r"\s+", "", c.upper()) for c in completed_courses]
    
    df = load_or_scrape_catalog(subject_code)
    G = nx.DiGraph()

    for _, row in df.iterrows():
        course = re.sub(r"\s+", "", str(row["Course Code"]).upper())
        prereq_text = str(row.get("Prerequisites", ""))
        prereqs = [re.sub(r"\s+", "", p.upper()) for p in extract_courses_codes(prereq_text)]
        for p in prereqs:
            G.add_edge(p, course)

    eligible, blocked = [], []
    for course in G.nodes:
        prereqs = list(G.predecessors(course))
        unmet = [p for p in prereqs if p not in completed_courses]
        if course in completed_courses:
            continue
        if not prereqs or not unmet:
            eligible.append(course)
        else:
            blocked.append(course)
    
    related = set()
    for c in completed_courses:
        if c in G:
            related.add(c)
            related.update(nx.descendants(G, c))
            related.update(nx.ancestors(G, c))
        else:
            print(f"Warning: {c} not found in graph nodes, skipping.")
        
    if related:
        G = G.subgraph(related).copy()

    node_colors = []
    for n in G.nodes:
        if n in completed_courses:
            node_colors.append("lightgreen") 
        elif n in eligible:
            node_colors.append("khaki")   
        else:
            node_colors.append("lightcoral")

    edge_colors = ["mediumseagreen" if u in completed_courses else "lightgray" for u, v in G.edges()]

    try:
        pos = graphviz_layout(G, prog="dot", args="-Grankdir=TB")
    except Exception as e:
        print("Graphviz layout failed, using spring layout instead:", e)
        pos = nx.spring_layout(G, k=0.7, iterations=60)

    plt.figure(figsize=(15, 10))
    nx.draw(
        G, pos,
        with_labels=True,
        node_color=node_colors,
        edge_color=edge_colors,
        node_size=1200,
        font_size=9,
        arrowsize=12,
        width=1.2,
    )

    nx.draw_networkx_edge_labels(
        G, pos,
        edge_labels={(u, v): "prereq" for (u, v) in G.edges()},
        font_size=6,
        label_pos=0.5
    )

    plt.title(f"{subject_code.upper()} Course Prerequisite Graph (with Eligibility)", fontsize=13, pad=15)
    plt.subplots_adjust(left=0.05, right=0.95, top=0.9, bottom=0.05)

    plt.savefig(save_path, dpi=300, bbox_inches="tight")
    print(f"Graph saved to {os.path.abspath(save_path)}")
    plt.show()
